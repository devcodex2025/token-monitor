# ─── Token Monitor ($TMR) — environment ───────────────────────────────────────
# PRD §8 env list. Copy to .env and fill in. NEVER commit real secrets.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RPC_FALLBACKS=https://api.mainnet-beta.solana.com

# Database (Neon in prod; docker-compose local)
DATABASE_URL=postgresql://tmr:tmr@localhost:5432/tmr

# Redis / queues (Upstash in prod)
REDIS_URL=redis://localhost:6379
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Solana data
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
