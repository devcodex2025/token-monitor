# Billing / crypto-only (Solana Pay)
VAULT_WALLET_ADDRESS=
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
TMR_TOKEN_MINT=

# Telegram
TELEGRAM_BOT_TOKEN=
