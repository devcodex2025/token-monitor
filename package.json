{
  "name": "token-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Token Monitor ($TMR) — Transparency & Analytics Layer for Solana",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @tmr/db db:generate",
    "db:migrate": "pnpm --filter @tmr/db db:migrate",
    "db:seed": "pnpm --filter @tmr/db db:seed"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.14.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
